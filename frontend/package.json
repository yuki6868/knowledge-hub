{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "npm run electron:icons && electron .",
    "electron:pack": "npm run electron:icons && electron-builder --mac --dir",
    "electron:dmg": "npm run electron:icons && electron-builder --mac dmg",
    "electron:icons": "node scripts/generate-electron-icons.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "tech.ai-system-design.knowledge-hub",
    "productName": "Knowledge Hub",
    "copyright": "Copyright © 2026 yuki nakagawa",
    "files": [
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "electron/assets/icon.icns"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "icon": "electron/assets/icon.icns"
    },
    "artifactName": "Knowledge-Hub-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "protocols": [
      {
        "name": "Knowledge Hub Auth Callback",
        "schemes": [
          "knowledge-hub"
        ]
      }
    ]
  }
}
